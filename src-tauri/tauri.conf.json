{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Music",
  "mainBinaryName": "youtube-music",
  "version": "1.0.0",
  "identifier": "io.github.shabgaming.ferric",
  "build": {
    "frontendDist": "https://music.youtube.com"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "publisher": "ShabGaming",
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "shortDescription": "A lightweight YouTube Music desktop app",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Ferric",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
